                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT GrupoClave, LimiteInferior, LimiteSuperior FROM cat.LimiteIQR WHERE IdLote = 0 AND Dataset = 'EVA' AND Campo = 'AreaCosechada'</property>
                <property
                  dataType="System.String"
                  description="Specifies a SQL statement that uses parameters to generate the lookup table."
                  expressionType="Notify"
                  name="SqlCommandParam"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (SELECT GrupoClave, LimiteInferior, LimiteSuperior
FROM cat.LimiteIQR
WHERE IdLote = 1 AND Dataset = 'EVA' AND Campo = 'AreaCosechada') [refTable]
where [refTable].[GrupoClave] = ?</property>
