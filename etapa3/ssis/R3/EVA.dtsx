    <DTS:Executable
      DTS:refId="Package\SQL_CalcularLimitesIQR"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8684068C-6DBD-417F-8DE1-FFE0F970C6C5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_CalcularLimitesIQR"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{15123FA2-F79E-4F75-A9B7-C186A2B8EE72}"
          SQLTask:SqlStatementSource=";WITH Base AS (&#xA;    SELECT&#xA;        LTRIM(RTRIM(Cultivo)) AS Cultivo,&#xA;        TRY_CONVERT(DECIMAL(14,2), REPLACE(REPLACE(LTRIM(RTRIM(AreaSembrada)),  '.', ''), ',', '.')) AS AreaSembrada,&#xA;        TRY_CONVERT(DECIMAL(14,2), REPLACE(REPLACE(LTRIM(RTRIM(AreaCosechada)), '.', ''), ',', '.')) AS AreaCosechada,&#xA;        TRY_CONVERT(DECIMAL(16,2), REPLACE(REPLACE(LTRIM(RTRIM(Produccion)),    '.', ''), ',', '.')) AS Produccion,&#xA;        TRY_CONVERT(DECIMAL(12,2), REPLACE(REPLACE(LTRIM(RTRIM(Rendimiento)),   '.', ''), ',', '.')) AS Rendimiento&#xA;    FROM dbo.stg_EVA&#xA;    WHERE IdLote = ?&#xA;),&#xA;Cuartiles AS (&#xA;    SELECT DISTINCT&#xA;        Cultivo,&#xA;        COUNT(*)                                                             OVER (PARTITION BY Cultivo) AS N_AreaSembrada,&#xA;        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY AreaSembrada)  OVER (PARTITION BY Cultivo) AS Q1_AreaSembrada,&#xA;        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY AreaSembrada)  OVER (PARTITION BY Cultivo) AS Q3_AreaSembrada,&#xA;        COUNT(*)                                                             OVER (PARTITION BY Cultivo) AS N_AreaCosechada,&#xA;        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY AreaCosechada) OVER (PARTITION BY Cultivo) AS Q1_AreaCosechada,&#xA;        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY AreaCosechada) OVER (PARTITION BY Cultivo) AS Q3_AreaCosechada,&#xA;        COUNT(*)                                                             OVER (PARTITION BY Cultivo) AS N_Produccion,&#xA;        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY Produccion)    OVER (PARTITION BY Cultivo) AS Q1_Produccion,&#xA;        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY Produccion)    OVER (PARTITION BY Cultivo) AS Q3_Produccion,&#xA;        COUNT(*)                                                             OVER (PARTITION BY Cultivo) AS N_Rendimiento,&#xA;        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY Rendimiento)   OVER (PARTITION BY Cultivo) AS Q1_Rendimiento,&#xA;        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY Rendimiento)   OVER (PARTITION BY Cultivo) AS Q3_Rendimiento&#xA;    FROM Base&#xA;)&#xA;INSERT cat.LimiteIQR (IdLote, Dataset, Campo, GrupoClave, N, Q1, Q3, LimiteInferior, LimiteSuperior)&#xA;SELECT ?, 'EVA', 'AreaSembrada', Cultivo, N_AreaSembrada, Q1_AreaSembrada, Q3_AreaSembrada,&#xA;       Q1_AreaSembrada - 1.5 * (Q3_AreaSembrada - Q1_AreaSembrada),&#xA;       Q3_AreaSembrada + 1.5 * (Q3_AreaSembrada - Q1_AreaSembrada)&#xA;FROM Cuartiles&#xA;UNION ALL&#xA;SELECT ?, 'EVA', 'AreaCosechada', Cultivo, N_AreaCosechada, Q1_AreaCosechada, Q3_AreaCosechada,&#xA;       Q1_AreaCosechada - 1.5 * (Q3_AreaCosechada - Q1_AreaCosechada),&#xA;       Q3_AreaCosechada + 1.5 * (Q3_AreaCosechada - Q1_AreaCosechada)&#xA;FROM Cuartiles&#xA;UNION ALL&#xA;SELECT ?, 'EVA', 'Produccion', Cultivo, N_Produccion, Q1_Produccion, Q3_Produccion,&#xA;       Q1_Produccion - 1.5 * (Q3_Produccion - Q1_Produccion),&#xA;       Q3_Produccion + 1.5 * (Q3_Produccion - Q1_Produccion)&#xA;FROM Cuartiles&#xA;UNION ALL&#xA;SELECT ?, 'EVA', 'Rendimiento', Cultivo, N_Rendimiento, Q1_Rendimiento, Q3_Rendimiento,&#xA;       Q1_Rendimiento - 1.5 * (Q3_Rendimiento - Q1_Rendimiento),&#xA;       Q3_Rendimiento + 1.5 * (Q3_Rendimiento - Q1_Rendimiento)&#xA;FROM Cuartiles;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::vIdLote"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::vIdLote"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::vIdLote"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::vIdLote"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::vIdLote"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
