      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="[LKP_IQR_AreaCosechada].[SqlCommand]">"SELECT GrupoClave, LimiteInferior, LimiteSuperior FROM cat.LimiteIQR WHERE IdLote = " + (DT_WSTR,10)@[User::vIdLote] + " AND Dataset = 'EVA' AND Campo = 'AreaCosechada'"</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="[LKP_IQR_AreaSembrada].[SqlCommand]">"SELECT GrupoClave, LimiteInferior, LimiteSuperior FROM cat.LimiteIQR WHERE IdLote = " + (DT_WSTR,10)@[User::vIdLote] + " AND Dataset = 'EVA' AND Campo = 'AreaSembrada'"</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="[LKP_IQR_Produccion].[SqlCommand]">"SELECT GrupoClave, LimiteInferior, LimiteSuperior FROM cat.LimiteIQR WHERE IdLote = " + (DT_WSTR,10)@[User::vIdLote] + " AND Dataset = 'EVA' AND Campo = 'Produccion'"</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="[LKP_IQR_Rendimiento].[SqlCommand]">"SELECT GrupoClave, LimiteInferior, LimiteSuperior FROM cat.LimiteIQR WHERE IdLote = " + (DT_WSTR,10)@[User::vIdLote] + " AND Dataset = 'EVA' AND Campo = 'Rendimiento'"</DTS:PropertyExpression>
