      <DTS:PropertyExpression
        DTS:Name="[LKP_IQR].[SqlCommand]">"SELECT Dataset, CAST(GrupoClave AS NVARCHAR(200)) AS GrupoClave, LimiteInferior, LimiteSuperior FROM cat.LimiteIQR WHERE IdLote = " + (DT_WSTR,10)@[User::vIdLote] + " AND Campo = 'Valor'"</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="[LKP_Regla].[SqlCommand]">"SELECT IdRegla, Codigo FROM cat.Regla WHERE Familia = 'FAOSTAT' AND Activa = 1 AND ReglasVersion = '" + @[$Project::pReglasVersionFaostat] + "'"</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="[LKP_UnidadReferencia].[SqlCommand]">"SELECT Dataset, CAST(CodigoProducto AS NVARCHAR(20)) AS CodigoProducto, CAST(CodigoElemento AS NVARCHAR(10)) AS CodigoElemento, UnidadModal FROM cat.UnidadReferencia WHERE IdLote = " + (DT_WSTR,10)@[User::vIdLote]</DTS:PropertyExpression>
