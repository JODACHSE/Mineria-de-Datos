          SQLTask:SqlStatementSource="{call etl.usp_AbrirLote(?, ?, ?, ?, ?, ?, ?, ?, ?, ?)}" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
